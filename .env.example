# PostgreSQL Connection Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kworb_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Scraper Settings
SCRAPE_DELAY_SECONDS=2
LOG_LEVEL=INFO
ARTIST_DETAILS_LIMIT=10

# AI Assistant (optional for chatbot)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
